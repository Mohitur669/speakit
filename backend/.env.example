# =========================================================================
# APPLICATION SERVER CONFIGURATION
# =========================================================================
SERVER_PORT=8080

# =========================================================================
# AWS POLLY & TRANSCRIBE CREDENTIALS
# =========================================================================
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1

# =========================================================================
# AWS SES CREDENTIALS (Optional: override if Polly and SES use different IAM users)
# =========================================================================
# AWS_SES_ACCESS_KEY_ID=your_aws_ses_access_key
# AWS_SES_SECRET_ACCESS_KEY=your_aws_ses_secret_key
# AWS_SES_REGION=ap-south-1
# AWS_SES_FROM_EMAIL=noreply@yourdomain.com

# =========================================================================
# THIRD-PARTY SPEECH & AI ENGINE APIS
# =========================================================================
ELEVENLABS_API_KEY=your_elevenlabs_api_key
SARVAM_API_KEY=your_sarvam_api_key

# =========================================================================
# DATABASE CONFIGURATION (PostgreSQL / Supabase)
# =========================================================================
# URL: Use the Session Pooler URL for IPv4 networks
SPRING_DATASOURCE_URL=jdbc:postgresql://your-db-host:5432/postgres?sslmode=require
# USERNAME: Usually 'postgres'
SPRING_DATASOURCE_USERNAME=postgres
# PASSWORD: The password set during database provisioning
SPRING_DATASOURCE_PASSWORD=your_db_password

SPRING_DATASOURCE_MAX_POOL_SIZE=10
SPRING_DATASOURCE_MIN_IDLE=5
SPRING_DATASOURCE_CONNECTION_TIMEOUT=20000
SPRING_DATASOURCE_IDLE_TIMEOUT=300000
SPRING_DATASOURCE_MAX_LIFETIME=1200000

# =========================================================================
# SECURITY & JWT
# =========================================================================
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# =========================================================================
# RATE LIMITING (Bucket4j In-Memory Shield)
# =========================================================================
RATE_LIMIT_CAPACITY=100
RATE_LIMIT_REFILL_TOKENS=100
RATE_LIMIT_REFILL_DURATION_MINUTES=1
RATE_LIMIT_LIVE_PARAM=100
RATE_LIMIT_PING_CAPACITY=60
RATE_LIMIT_PING_REFILL_TOKENS=60
RATE_LIMIT_PING_REFILL_DURATION_MINUTES=1

# =========================================================================
# CORS CONFIGURATION
# =========================================================================
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Session Management
SESSION_POLL_INTERVAL_MS=60000
IDLE_TIMEOUT_MS=3000000
SESSION_DURATION_MS=7200000

# Render / Self-Ping Keep-Alive
RENDER_EXTERNAL_URL=https://your-app.onrender.com
SELF_PING_URL=https://your-app.onrender.com
KEEP_ALIVE_INTERVAL_MS=600000

# =========================================================================
# LOGGING CONFIGURATION
# =========================================================================
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_SPRING=WARN
LOG_LEVEL_APP=INFO

# Log File Management
LOG_FILE_PATH=logs/speakit-backend.log
LOG_MAX_FILE_SIZE=20MB
LOG_MAX_HISTORY=10
LOG_TOTAL_SIZE_CAP=200MB

# =========================================================================
# PAYMENT GATEWAY (Razorpay Integration)
# =========================================================================
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# =========================================================================
# EMAIL & OTP DELIVERY (Resend / Amazon SES / SMTP)
# =========================================================================
# Resend Email Integration (Primary)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_ADDRESS=noreply@yourdomain.com
OTP_PROVIDER=resend # Set to 'legacy' to fallback to SES/SMTP

# Amazon SES SMTP Settings (Fallback)
MAIL_HOST=email-smtp.ap-south-1.amazonaws.com
MAIL_PORT=587
MAIL_USERNAME=your_ses_smtp_username
MAIL_PASSWORD=your_ses_smtp_password
MAIL_FROM=noreply@yourdomain.com
EMAIL_PROVIDER=SMTP
OTP_EXPIRY_MINUTES=10

# =========================================================================
# OBSERVABILITY & MONITORING
# =========================================================================
# Sentry Error Tracking
SENTRY_DSN_BACKEND=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_RELEASE=
SENTRY_EXCEPTION_RESOLVER_ORDER=-2147483648
SENTRY_SEND_DEFAULT_PII=false

# New Relic Log Aggregator Configuration
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=speakit-prod-backend
NEW_RELIC_LOG_ENDPOINT_REGION=US

# Telegram Alert Bot (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord Webhook Alert (Contact Form & Backend Operations)
DISCORD_CONTACT_FORM_WEBHOOK_URL=
DISCORD_BACKEND_WEBHOOK_URL=

# =========================================================================
# CLOUDFLARE R2 OBJECT STORAGE (Dual-Bucket Architecture)
# =========================================================================
# Cloudflare R2 Account ID (found in Cloudflare Dashboard URL or R2 overview)
R2_ACCOUNT_ID=your_cloudflare_account_id

# Cloudflare R2 S3-Compatible API Credentials (Token with Object Read/Write permissions)
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# 1. Bucket A: User Avatars
R2_BUCKET_NAME=speakit-avatars
R2_PUBLIC_URL=https://cdn-speakit-avatar.yourdomain.com
AVATAR_DAILY_LIMIT=2

# 2. Bucket B: Audio Storage (TTS Generations & STT Cache)
# Note: Cloudflare enforces exactly 1 Custom Domain per R2 Bucket
R2_AUDIO_BUCKET_NAME=speakit-audio
R2_AUDIO_PUBLIC_URL=https://cdn-speakit-audio.yourdomain.com

# 3. Bucket C: Log Backups (Disaster Recovery & Scheduled Nightly Archives)
R2_LOG_BUCKET_NAME=speakit-logs
R2_LOG_ACCESS_KEY_ID=your_r2_log_access_key_id
R2_LOG_SECRET_ACCESS_KEY=your_r2_log_secret_access_key
LOG_ENVIRONMENT=local
LOCAL_LOGS_DIR=logs/speakit-backend.log
# In Coolify container, logs are stored at /app/logs. Override only if using custom volume mounts.
COOLIFY_LOGS_DIR=/app/logs
TZ=Asia/Kolkata
