    "java.configuration.updateBuildConfiguration": "interactive",
    "java.configuration.runtimes": [
        {
            "name": "JavaSE-25",
            "path": "/Library/Java/JavaVirtualMachines/jdk-25.jdk/Contents/Home",
            "default": true
        }
    ]
