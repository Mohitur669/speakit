{
	"info": {
		"_postman_id": "speakit-api-collection-v2",
		"name": "SpeakIT API v1.1",
		"description": "Production API collection for SpeakIT - Includes Auth, Studio, Analytics, and Marketing services.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Register User",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"johndoe\",\n    \"email\": \"john@example.com\",\n    \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"register"
							]
						}
					}
				},
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.environment.set(\"token\", jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"johndoe\",\n    \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						}
					}
				},
				{
					"name": "Logout",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/auth/logout",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"logout"
							]
						},
						"description": "Invalidates the current session globally by incrementing session_version."
					}
				},
				{
					"name": "Platform Ping",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/auth/ping",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"ping"
							]
						},
						"description": "Lightweight health check for Render keep-alive."
					}
				}
			]
		},
		{
			"name": "Voice Studio",
			"item": [
				{
					"name": "Get Voices",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/tts/voices",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"tts",
								"voices"
							]
						},
						"description": "Returns a list of voices filtered by user plan (Pro users see Neural engines)."
					}
				},
				{
					"name": "Synthesize (Buffer)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"text\": \"This is a production test synthesis.\",\n    \"voiceId\": \"Joanna\",\n    \"outputFormat\": \"mp3\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/tts/synthesize",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"tts",
								"synthesize"
							]
						},
						"description": "Generates audio bytes. Limits: 200 (Free) / 3000 (Pro)."
					}
				},
				{
					"name": "Synthesize (Stream)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"text\": \"Streaming high-quality audio...\",\n    \"voiceId\": \"Matthew\",\n    \"outputFormat\": \"mp3\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/tts/synthesize-stream",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"tts",
								"synthesize-stream"
							]
						}
					}
				}
			]
		},
		{
			"name": "Analytics & History",
			"item": [
				{
					"name": "Get Conversion History",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/history?page=0&size=20",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"history"
							],
							"query": [
								{
									"key": "page",
									"value": "0"
								},
								{
									"key": "size",
									"value": "20"
								}
							]
						},
						"description": "Paginated history of TTS conversion requests."
					}
				}
			]
		},
		{
			"name": "Marketing & Public",
			"item": [
				{
					"name": "Submit Contact Form",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"firstName\": \"John\",\n    \"lastName\": \"Doe\",\n    \"email\": \"john@example.com\",\n    \"topic\": \"support\",\n    \"message\": \"I need help with my Pro subscription.\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/contact",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"contact"
							]
						}
					}
				}
			]
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		}
	]
}
